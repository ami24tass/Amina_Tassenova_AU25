/* ============ CTE ============ */
WITH films_after_2015 AS (
  SELECT f.film_id
  FROM sakila.film AS f
  WHERE f.release_year > 2015
)
SELECT a.first_name, a.last_name, COUNT(*) AS number_of_movies
FROM sakila.actor AS a
INNER JOIN sakila.film_actor AS fa ON fa.actor_id = a.actor_id
INNER JOIN films_after_2015   AS f2 ON f2.film_id = fa.film_id
GROUP BY a.first_name, a.last_name
ORDER BY number_of_movies DESC, a.last_name, a.first_name
LIMIT 5;

/* ============ Subquery ============ */
SELECT a.first_name, a.last_name, COUNT(*) AS number_of_movies
FROM sakila.actor AS a
INNER JOIN sakila.film_actor AS fa ON fa.actor_id = a.actor_id
INNER JOIN (
  SELECT film_id FROM sakila.film WHERE release_year > 2015
) AS f2 ON f2.film_id = fa.film_id
GROUP BY a.first_name, a.last_name
ORDER BY number_of_movies DESC, a.last_name, a.first_name
LIMIT 5;

/* ============ JOIN-вариант ============ */
SELECT a.first_name, a.last_name, COUNT(*) AS number_of_movies
FROM sakila.actor AS a
INNER JOIN sakila.film_actor AS fa ON fa.actor_id = a.actor_id
INNER JOIN sakila.film       AS f  ON f.film_id   = fa.film_id
WHERE f.release_year > 2015
GROUP BY a.first_name, a.last_name
ORDER BY number_of_movies DESC, a.last_name, a.first_name
LIMIT 5;


