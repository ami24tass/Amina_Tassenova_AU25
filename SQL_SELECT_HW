/* ============ CTE ============ */
WITH payments_since_apr2017 AS (
  SELECT p.payment_id, p.amount, p.payment_date, r.inventory_id
  FROM sakila.payment AS p
  INNER JOIN sakila.rental  AS r ON r.rental_id = p.rental_id
  WHERE p.payment_date >= DATE '2017-04-01'
),
store_map AS (
  SELECT i.inventory_id, s.store_id, a.address, a.address2
  FROM sakila.inventory AS i
  INNER JOIN sakila.store     AS s ON s.store_id = i.store_id
  INNER JOIN sakila.address   AS a ON a.address_id = s.address_id
)
SELECT 
  sm.store_id,
  TRIM(CONCAT(sm.address, ' ', COALESCE(sm.address2, ''))) AS address_full,
  SUM(ps.amount) AS revenue
FROM payments_since_apr2017 AS ps
INNER JOIN store_map AS sm ON sm.inventory_id = ps.inventory_id
GROUP BY sm.store_id, address_full
ORDER BY revenue DESC;

/* ============ Subquery ============ */
SELECT 
  t.store_id,
  TRIM(CONCAT(t.address, ' ', COALESCE(t.address2, ''))) AS address_full,
  SUM(t.amount) AS revenue
FROM (
  SELECT 
    s.store_id,
    a.address,
    a.address2,
    p.amount
  FROM sakila.payment AS p
  INNER JOIN sakila.rental   AS r  ON r.rental_id = p.rental_id
  INNER JOIN sakila.inventory AS i ON i.inventory_id = r.inventory_id
  INNER JOIN sakila.store     AS s ON s.store_id = i.store_id
  INNER JOIN sakila.address   AS a ON a.address_id = s.address_id
  WHERE p.payment_date >= DATE '2017-04-01'
) AS t
GROUP BY t.store_id, address_full
ORDER BY revenue DESC;

/* ============ JOIN-вариант ============ */
SELECT 
  s.store_id,
  TRIM(CONCAT(a.address, ' ', COALESCE(a.address2, ''))) AS address_full,
  SUM(p.amount) AS revenue
FROM sakila.payment   AS p
INNER JOIN sakila.rental    AS r ON r.rental_id = p.rental_id
INNER JOIN sakila.inventory AS i ON i.inventory_id = r.inventory_id
INNER JOIN sakila.store     AS s ON s.store_id = i.store_id
INNER JOIN sakila.address   AS a ON a.address_id = s.address_id
WHERE p.payment_date >= DATE '2017-04-01'
GROUP BY s.store_id, address_full
ORDER BY revenue DESC;


