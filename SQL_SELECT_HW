/* ============ CTE ============ */
WITH pay17 AS (
  SELECT p.payment_id, p.amount, p.payment_date, p.staff_id, r.inventory_id
  FROM sakila.payment AS p
  INNER JOIN sakila.rental AS r ON r.rental_id = p.rental_id
  WHERE p.payment_date >= DATE '2017-01-01'
    AND p.payment_date <  DATE '2018-01-01'
),
rev17 AS (
  SELECT staff_id, SUM(amount) AS revenue_2017
  FROM pay17
  GROUP BY staff_id
),
last_store AS (
  SELECT
    p1.staff_id,
    s.store_id
  FROM pay17 AS p1
  INNER JOIN sakila.inventory AS i ON i.inventory_id = p1.inventory_id
  INNER JOIN sakila.store     AS s ON s.store_id     = i.store_id
  WHERE p1.payment_date = (
    SELECT MAX(p2.payment_date)
    FROM pay17 AS p2
    WHERE p2.staff_id = p1.staff_id
  )
)
SELECT st.staff_id,
       st.first_name,
       st.last_name,
       ls.store_id    AS last_store_id_2017,
       rv.revenue_2017
FROM rev17 AS rv
INNER JOIN sakila.staff AS st ON st.staff_id = rv.staff_id
LEFT  JOIN last_store   AS ls ON ls.staff_id = rv.staff_id
ORDER BY rv.revenue_2017 DESC, st.last_name, st.first_name
LIMIT 3;

/* ============ Subquery ============ */
SELECT
  st.staff_id,
  st.first_name,
  st.last_name,
  (
    SELECT s.store_id
    FROM sakila.payment AS p1
    INNER JOIN sakila.rental    AS r1 ON r1.rental_id = p1.rental_id
    INNER JOIN sakila.inventory AS i1 ON i1.inventory_id = r1.inventory_id
    INNER JOIN sakila.store     AS s  ON s.store_id = i1.store_id
    WHERE p1.payment_date >= DATE '2017-01-01'
      AND p1.payment_date <  DATE '2018-01-01'
      AND p1.staff_id = st.staff_id
    ORDER BY p1.payment_date DESC
    LIMIT 1
  ) AS last_store_id_2017,
  (
    SELECT SUM(p.amount)
    FROM sakila.payment AS p
    WHERE p.payment_date >= DATE '2017-01-01'
      AND p.payment_date <  DATE '2018-01-01'
      AND p.staff_id = st.staff_id
  ) AS revenue_2017
FROM sakila.staff AS st
WHERE (
  SELECT SUM(p.amount)
  FROM sakila.payment AS p
  WHERE p.payment_date >= DATE '2017-01-01'
    AND p.payment_date <  DATE '2018-01-01'
    AND p.staff_id = st.staff_id
) IS NOT NULL
ORDER BY revenue_2017 DESC, st.last_name, st.first_name
LIMIT 3;

/* ============ JOIN-вариант ============ */
-- В JOIN-варианте без окон найдём rev по staff, а last_store — через коррелированный подзапрос:
SELECT
  st.staff_id,
  st.first_name,
  st.last_name,
  (
    SELECT s.store_id
    FROM sakila.payment AS p1
    INNER JOIN sakila.rental    AS r1 ON r1.rental_id = p1.rental_id
    INNER JOIN sakila.inventory AS i1 ON i1.inventory_id = r1.inventory_id
    INNER JOIN sakila.store     AS s  ON s.store_id = i1.store_id
    WHERE p1.payment_date >= DATE '2017-01-01'
      AND p1.payment_date <  DATE '2018-01-01'
      AND p1.staff_id = st.staff_id
    ORDER BY p1.payment_date DESC
    LIMIT 1
  ) AS last_store_id_2017,
  rv.revenue_2017
FROM (
  SELECT p.staff_id, SUM(p.amount) AS revenue_2017
  FROM sakila.payment AS p
  WHERE p.payment_date >= DATE '2017-01-01'
    AND p.payment_date <  DATE '2018-01-01'
  GROUP BY p.staff_id
) AS rv
INNER JOIN sakila.staff AS st ON st.staff_id = rv.staff_id
ORDER BY rv.revenue_2017 DESC, st.last_name, st.first_name
LIMIT 3;

