/* ============ CTE ============ */
WITH film_rentals AS (
  SELECT i.film_id, COUNT(*) AS rentals_cnt
  FROM sakila.rental AS r
  INNER JOIN sakila.inventory AS i ON i.inventory_id = r.inventory_id
  GROUP BY i.film_id
)
SELECT 
  f.title,
  fr.rentals_cnt,
  f.rating,
  CASE f.rating
    WHEN 'G'      THEN 0
    WHEN 'PG'     THEN 10
    WHEN 'PG-13'  THEN 13
    WHEN 'R'      THEN 17
    WHEN 'NC-17'  THEN 18
    ELSE NULL
  END AS expected_age
FROM film_rentals AS fr
INNER JOIN sakila.film AS f ON f.film_id = fr.film_id
ORDER BY fr.rentals_cnt DESC, f.title
LIMIT 5;

/* ============ Subquery ============ */
SELECT 
  f.title,
  fr.rentals_cnt,
  f.rating,
  CASE f.rating
    WHEN 'G'      THEN 0
    WHEN 'PG'     THEN 10
    WHEN 'PG-13'  THEN 13
    WHEN 'R'      THEN 17
    WHEN 'NC-17'  THEN 18
    ELSE NULL
  END AS expected_age
FROM sakila.film AS f
INNER JOIN (
  SELECT i.film_id, COUNT(*) AS rentals_cnt
  FROM sakila.rental AS r
  INNER JOIN sakila.inventory AS i ON i.inventory_id = r.inventory_id
  GROUP BY i.film_id
) AS fr ON fr.film_id = f.film_id
ORDER BY fr.rentals_cnt DESC, f.title
LIMIT 5;

/* ============ JOIN-вариант ============ */
SELECT 
  f.title,
  COUNT(*) AS rentals_cnt,
  f.rating,
  CASE f.rating
    WHEN 'G'      THEN 0
    WHEN 'PG'     THEN 10
    WHEN 'PG-13'  THEN 13
    WHEN 'R'      THEN 17
    WHEN 'NC-17'  THEN 18
    ELSE NULL
  END AS expected_age
FROM sakila.rental AS r
INNER JOIN sakila.inventory AS i ON i.inventory_id = r.inventory_id
INNER JOIN sakila.film     AS f ON f.film_id      = i.film_id
GROUP BY f.title, f.rating
ORDER BY rentals_cnt DESC, f.title
LIMIT 5;


/* =======================================================================================
   PART 3  — Actors’ inactivity
   ======================================================================================= */

/* -----------------------------------------------------------------------------
   V1: Gap between latest release_year and current year per actor
   Business interpretation:
   - Для каждого актёра: current_year - MAX(release_year).
   ----------------------------------------------------------------------------- */

/* ============ CTE ============ */
WITH last_year AS (
  SELECT fa.actor_id, MAX(f.release_year) AS last_release_year
  FROM sakila.film_actor AS fa
  INNER JOIN sakila.film AS f ON f.film_id = fa.film_id
  GROUP BY fa.actor_id
)
SELECT a.first_name, a.last_name,
       (EXTRACT(YEAR FROM CURRENT_DATE) - ly.last_release_year) AS years_inactive
FROM last_year AS ly
INNER JOIN sakila.actor AS a ON a.actor_id = ly.actor_id
ORDER BY years_inactive DESC, a.last_name, a.first_name;

/* ============ Subquery ============ */
SELECT a.first_name, a.last_name,
       (EXTRACT(YEAR FROM CURRENT_DATE) - (
          SELECT MAX(f.release_year)
          FROM sakila.film_actor AS fa
          INNER JOIN sakila.film AS f ON f.film_id = fa.film_id
          WHERE fa.actor_id = a.actor_id
       )) AS years_inactive
FROM sakila.actor AS a
WHERE EXISTS (
  SELECT 1 FROM sakila.film_actor AS fa WHERE fa.actor_id = a.actor_id
)
ORDER BY years_inactive DESC, a.last_name, a.first_name;

/* ============ JOIN-вариант ============ */
SELECT a.first_name, a.last_name,
       (EXTRACT(YEAR FROM CURRENT_DATE) - MAX(f.release_year)) AS years_inactive
FROM sakila.actor AS a
INNER JOIN sakila.film_actor AS fa ON fa.actor_id = a.actor_id
INNER JOIN sakila.film       AS f  ON f.film_id   = fa.film_id
GROUP BY a.first_name, a.last_name
ORDER BY years_inactive DESC, a.last_name, a.first_name;

--3 part

/* ============ CTE ============ */
WITH actor_years AS (
  SELECT DISTINCT fa.actor_id, f.release_year
  FROM sakila.film_actor AS fa
  INNER JOIN sakila.film AS f ON f.film_id = fa.film_id
),
next_year AS (
  SELECT ay.actor_id,
         ay.release_year AS y1,
         (
           SELECT MIN(ay2.release_year)
           FROM actor_years AS ay2
           WHERE ay2.actor_id = ay.actor_id
             AND ay2.release_year > ay.release_year
         ) AS y2
  FROM actor_years AS ay
),
gaps AS (
  SELECT actor_id, (y2 - y1) AS gap
  FROM next_year
  WHERE y2 IS NOT NULL
)
SELECT a.first_name, a.last_name, MAX(g.gap) AS max_gap_years
FROM gaps AS g
INNER JOIN sakila.actor AS a ON a.actor_id = g.actor_id
GROUP BY a.first_name, a.last_name
ORDER BY max_gap_years DESC, a.last_name, a.first_name;

/* ============ Subquery ============ */
SELECT a.first_name, a.last_name, t.max_gap_years
FROM sakila.actor AS a
INNER JOIN (
  SELECT g.actor_id, MAX(g.gap) AS max_gap_years
  FROM (
    SELECT ay.actor_id,
           (
             SELECT MIN(ay2.release_year)
             FROM (
               SELECT DISTINCT fa2.actor_id, f2.release_year
               FROM sakila.film_actor AS fa2
               INNER JOIN sakila.film AS f2 ON f2.film_id = fa2.film_id
             ) AS ay2
             WHERE ay2.actor_id = ay.actor_id
               AND ay2.release_year > ay.release_year
           ) - ay.release_year AS gap
    FROM (
      SELECT DISTINCT fa.actor_id, f.release_year
      FROM sakila.film_actor AS fa
      INNER JOIN sakila.film AS f ON f.film_id = fa.film_id
    ) AS ay
  ) AS g
  WHERE g.gap IS NOT NULL
  GROUP BY g.actor_id
) AS t ON t.actor_id = a.actor_id
ORDER BY t.max_gap_years DESC, a.last_name, a.first_name;

/* ============ JOIN-вариант (без окон) ============ */
-- Тут всё равно нужен коррелированный MIN(...) для "следующего года" — иначе без окон
-- корректно найти соседей по времени сложно. JOIN-часть — внешняя агрегация.
SELECT a.first_name, a.last_name, MAX(gy.gap) AS max_gap_years
FROM sakila.actor AS a
INNER JOIN (
  SELECT ay.actor_id,
         (
           SELECT MIN(ay2.release_year)
           FROM (
             SELECT DISTINCT fa2.actor_id, f2.release_year
             FROM sakila.film_actor AS fa2
             INNER JOIN sakila.film AS f2 ON f2.film_id = fa2.film_id
           ) AS ay2
           WHERE ay2.actor_id = ay.actor_id
             AND ay2.release_year > ay.release_year
         ) - ay.release_year AS gap
  FROM (
    SELECT DISTINCT fa.actor_id, f.release_year
    FROM sakila.film_actor AS fa
    INNER JOIN sakila.film AS f ON f.film_id = fa.film_id
  ) AS ay
) AS gy ON gy.actor_id = a.actor_id
WHERE gy.gap IS NOT NULL
GROUP BY a.first_name, a.last_name
ORDER BY max_gap_years DESC, a.last_name, a.first_name;
