/* ============ CTE ============ */
WITH film_with_cat AS (
  SELECT f.film_id, f.release_year, c.name AS category_name
  FROM sakila.film AS f
  LEFT JOIN sakila.film_category AS fc ON fc.film_id = f.film_id
  LEFT JOIN sakila.category      AS c  ON c.category_id = fc.category_id
)
SELECT 
  release_year,
  SUM(CASE WHEN category_name = 'Drama'       THEN 1 ELSE 0 END) AS number_of_drama_movies,
  SUM(CASE WHEN category_name = 'Travel'      THEN 1 ELSE 0 END) AS number_of_travel_movies,
  SUM(CASE WHEN category_name = 'Documentary' THEN 1 ELSE 0 END) AS number_of_documentary_movies
FROM film_with_cat
GROUP BY release_year
ORDER BY release_year DESC;

/* ============ Subquery ============ */
SELECT 
  t.release_year,
  SUM(CASE WHEN t.category_name = 'Drama'       THEN 1 ELSE 0 END) AS number_of_drama_movies,
  SUM(CASE WHEN t.category_name = 'Travel'      THEN 1 ELSE 0 END) AS number_of_travel_movies,
  SUM(CASE WHEN t.category_name = 'Documentary' THEN 1 ELSE 0 END) AS number_of_documentary_movies
FROM (
  SELECT f.film_id, f.release_year, c.name AS category_name
  FROM sakila.film AS f
  LEFT JOIN sakila.film_category AS fc ON fc.film_id = f.film_id
  LEFT JOIN sakila.category      AS c  ON c.category_id = fc.category_id
) AS t
GROUP BY t.release_year
ORDER BY t.release_year DESC;

/* ============ JOIN-вариант ============ */
SELECT 
  f.release_year,
  SUM(CASE WHEN c.name = 'Drama'       THEN 1 ELSE 0 END) AS number_of_drama_movies,
  SUM(CASE WHEN c.name = 'Travel'      THEN 1 ELSE 0 END) AS number_of_travel_movies,
  SUM(CASE WHEN c.name = 'Documentary' THEN 1 ELSE 0 END) AS number_of_documentary_movies
FROM sakila.film AS f
LEFT JOIN sakila.film_category AS fc ON fc.film_id = f.film_id
LEFT JOIN sakila.category      AS c  ON c.category_id = fc.category_id
GROUP BY f.release_year
ORDER BY f.release_year DESC;



